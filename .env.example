# Supabase (project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — transcript → verdict extraction (gpt-5.4-mini)
OPENAI_API_KEY=

# ElevenLabs — voice agent + outbound calls
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Dial routing: DEV_TEST (team phones) | REAL (verified pharmacies)
DIAL_MODE=DEV_TEST
# Comma-separated team numbers used by DEV_TEST fake pharmacies
DEV_TEST_PHONE_NUMBERS=

# Safety
DIALING_ENABLED=true
GLOBAL_CAP=8
INTERNAL_SECRET=

# NHS Directory of Healthcare Services API v3 (5.0 pharmacy ingestion,
# seed-time only). Key from the NHS Digital Onboarding Service — `int`
# environment is self-service, `prod` needs onboarding approval. Used by
# `npm run seed:nhs`; the app itself never calls the NHS API.
NHS_DOHS_API_KEY=

# PostHog analytics (OPTIONAL — vendored with the relay UI; analytics is fully
# disabled when the key is unset; events never include the postcode)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
