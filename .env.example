# Supabase (project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — transcript → verdict extraction (gpt-5.4-mini)
OPENAI_API_KEY=

# ElevenLabs — voice agent + outbound calls
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Dial routing: DEV_TEST (team phones) | REAL (verified pharmacies)
DIAL_MODE=DEV_TEST
# Comma-separated team numbers used by DEV_TEST fake pharmacies
DEV_TEST_PHONE_NUMBERS=

# Safety
DIALING_ENABLED=true
GLOBAL_CAP=8
INTERNAL_SECRET=

# PostHog analytics (OPTIONAL — vendored with the relay UI; analytics is fully
# disabled when the key is unset; events never include the postcode)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
